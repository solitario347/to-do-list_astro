---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Agendar Cita">
  <main class="container">
    <div class="card">
      <h2>Agendar Nueva Cita</h2>
      <p>Completa la información para reservar tu espacio</p>

      <form id="bookingForm">
        <div class="field">
          <label>Servicio Requerido</label>
          <select required>
            <option value="">Selecciona un servicio</option>
            <option value="1">Atención al Cliente</option>
            <option value="2">Soporte Técnico</option>
            <option value="3">Consultoría Especializada</option>
          </select>
        </div>

        <div class="field-row">
          <div class="field">
            <label>Fecha</label>
            <input type="date" required />
          </div>
          <div class="field">
            <label>Hora</label>
            <input type="time" required />
          </div>
        </div>

        <div class="field">
          <label>Notas adicionales</label>
          <textarea rows="3" placeholder="Detalles de la consulta..."></textarea>
        </div>

        <div class="actions">
          <button type="submit" class="btn btn-primary">Confirmar Reserva</button>
          <a href="/dashboard" class="btn btn-secondary">Cancelar</a>
        </div>
      </form>
    </div>
  </main>
</Layout>

<style>
  .container { display: flex; justify-content: center; align-items: center; min-height: 85vh; font-family: system-ui, sans-serif; }
  .card { background: #1e1e2e; color: #f8f8f2; padding: 2.5rem; border-radius: 12px; border: 1px solid #313244; width: 100%; max-width: 480px; }
  h2 { margin: 0 0 0.5rem; color: #fff; }
  p { color: #a6adc8; font-size: 0.9rem; margin-bottom: 1.5rem; }
  .field { display: flex; flex-direction: column; gap: 0.4rem; margin-bottom: 1.2rem; flex: 1; }
  .field-row { display: flex; gap: 1rem; }
  label { font-size: 0.85rem; color: #cdd6f4; }
  input, select, textarea { padding: 0.75rem; border-radius: 6px; border: 1px solid #45475a; background: #11111b; color: #fff; font-family: inherit; }
  .actions { display: flex; gap: 1rem; margin-top: 1rem; }
  .btn { padding: 0.8rem 1.2rem; border-radius: 6px; font-weight: bold; text-decoration: none; text-align: center; border: none; cursor: pointer; flex: 1; }
  .btn-primary { background: #89b4fa; color: #11111b; }
  .btn-secondary { background: #313244; color: #cdd6f4; border: 1px solid #45475a; }
</style>

<script>
  const form = document.getElementById('bookingForm') as HTMLFormElement;
  
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    
    const servicioSelect = form.querySelector('select') as HTMLSelectElement;
    const fechaInput = form.querySelector('input[type="date"]') as HTMLInputElement;
    const horaInput = form.querySelector('input[type="time"]') as HTMLInputElement;

    const nuevaCita = {
      id: '#' + Math.floor(100 + Math.random() * 900),
      cliente: 'Cliente Actual',
      servicio: servicioSelect?.options[servicioSelect.selectedIndex]?.text || 'Servicio General',
      fecha: `${fechaInput?.value} ${horaInput?.value}`,
      estado: 'Pendiente'
    };

    const citasGuardadas = JSON.parse(localStorage.getItem('citasEmpresa') || '[]');
    citasGuardadas.push(nuevaCita);
    localStorage.setItem('citasEmpresa', JSON.stringify(citasGuardadas));

    alert('¡Cita agendada con éxito!');
    window.location.href = '/dashboard';
  });
</script>