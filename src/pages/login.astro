---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Iniciar Sesión">
  <main class="container">
    <div class="card">
      <h2>Iniciar Sesión</h2>
      <p>Accede para gestionar tus citas</p>

      <form id="loginForm">
        <div class="field">
          <label for="email">Correo Electrónico</label>
          <input type="email" id="email" placeholder="usuario@empresa.com" required />
        </div>
        <div class="field">
          <label for="password">Contraseña</label>
          <input type="password" id="password" placeholder="••••••••" required />
        </div>
        <button type="submit" class="btn">Ingresar</button>
      </form>
    </div>
  </main>
</Layout>

<style>
  .container { display: flex; justify-content: center; align-items: center; min-height: 80vh; font-family: system-ui, sans-serif; }
  .card { background: #1e1e2e; color: #f8f8f2; padding: 2.5rem; border-radius: 12px; border: 1px solid #313244; width: 100%; max-width: 380px; }
  h2 { margin: 0 0 0.5rem; color: #fff; }
  p { color: #a6adc8; font-size: 0.9rem; margin-bottom: 1.5rem; }
  .field { display: flex; flex-direction: column; gap: 0.4rem; margin-bottom: 1.2rem; }
  label { font-size: 0.85rem; color: #cdd6f4; }
  input { padding: 0.75rem; border-radius: 6px; border: 1px solid #45475a; background: #11111b; color: #fff; }
  .btn { background: #89b4fa; color: #11111b; border: none; padding: 0.8rem; border-radius: 6px; font-weight: bold; cursor: pointer; margin-top: 0.5rem; }
  .btn:hover { background: #b4befe; }
</style>

<script>
  const form = document.getElementById('loginForm') as HTMLFormElement | null;

  form?.addEventListener('submit', (e) => {
    e.preventDefault();

    const emailInput = document.getElementById('email') as HTMLInputElement | null;
    const passwordInput = document.getElementById('password') as HTMLInputElement | null;

    const email = emailInput?.value.trim().toLowerCase() || '';
    const password = passwordInput?.value || '';

    if (!email || !password) return;

    // Redirección por rol
    if (email.includes('admin')) {
      localStorage.setItem('userRole', 'admin');
      window.location.href = '/admin';
    } else {
      localStorage.setItem('userRole', 'cliente');
      window.location.href = '/dashboard';
    }
  });
</script>