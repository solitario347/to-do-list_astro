---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Inicio - Sistema de Gestión de Citas">
    <main class="flex flex-col items-center justify-center min-h-screen px-4 text-center">
        <div class="max-w-2xl space-y-6">
            <span class="px-3 py-1 text-sm font-semibold text-blue-600 bg-blue-100 rounded-full">
                Sistema Profesional
            </span>
            <h1 class="text-4xl font-extrabold tracking-tight sm:text-5xl text-gray-900">
                Gestión Inteligente de Citas para tu Empresa
            </h1>
            <p class="text-lg text-gray-600">
                Administra tu agenda, optimiza el tiempo de tus clientes y controla los roles de acceso de manera eficiente.
            </p>
            <div class="flex flex-wrap justify-center gap-4 pt-4">
                <a 
                    href="/login" 
                    class="px-6 py-3 font-medium text-white bg-blue-600 rounded-lg shadow hover:bg-blue-700 transition"
                >
                    Iniciar Sesión
                </a>
                <a 
                    href="/dashboard" 
                    class="px-6 py-3 font-medium text-gray-700 bg-white border border-gray-300 rounded-lg shadow-sm hover:bg-gray-50 transition"
                >
                    Ver Dashboard (Demo)
                </a>
            </div>
        </div>
    </main>
</Layout>