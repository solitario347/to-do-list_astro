---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Gestión de Citas - Inicio">
  <main class="hero-container">
    <div class="hero-card">
      <span class="badge">Sistema Profesional</span>
      <h1>Gestión Inteligente de Citas para tu Empresa</h1>
      <p>Administra tu agenda, optimiza el tiempo de tus clientes y controla los roles de acceso de manera eficiente.</p>
      
      <div class="actions">
        <a href="/login" class="btn btn-primary">Iniciar Sesión</a>
        <a href="/dashboard" class="btn btn-secondary">Ver Dashboard (Demo)</a>
      </div>
    </div>
  </main>
</Layout>

<style>
  .hero-container {
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 80vh;
    padding: 2rem;
    font-family: system-ui, -apple-system, sans-serif;
  }

  .hero-card {
    max-width: 650px;
    background: #1e1e2e;
    color: #f8f8f2;
    padding: 3rem;
    border-radius: 12px;
    border: 1px solid #313244;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
  }

  .badge {
    background: #313244;
    color: #cba6f7;
    padding: 0.4rem 0.8rem;
    border-radius: 6px;
    font-size: 0.85rem;
    font-weight: 600;
  }

  h1 {
    font-size: 2.2rem;
    margin: 1.2rem 0 0.8rem;
    line-height: 1.2;
    color: #ffffff;
  }

  p {
    color: #a6adc8;
    line-height: 1.5;
    margin-bottom: 2rem;
  }

  .actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .btn {
    text-decoration: none;
    padding: 0.8rem 1.4rem;
    border-radius: 8px;
    font-weight: 600;
    transition: background 0.2s ease;
  }

  .btn-primary {
    background: #89b4fa;
    color: #11111b;
  }

  .btn-primary:hover {
    background: #b4befe;
  }

  .btn-secondary {
    background: #313244;
    color: #cdd6f4;
    border: 1px solid #45475a;
  }

  .btn-secondary:hover {
    background: #45475a;
  }
</style>